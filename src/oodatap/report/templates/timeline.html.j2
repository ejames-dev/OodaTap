<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>OodaTap Timeline Report — {{ report.source_path }}</title>
<style>
  :root {
    --bg: #0b0f17;
    --panel: #121826;
    --border: #232d42;
    --text: #e6edf7;
    --muted: #8b9bb4;
    --cyan: #38bdf8;
    --violet: #a78bfa;
    --amber: #f59e0b;
    --red: #f43f5e;
    --green: #10b981;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 28px;
    background: var(--bg); color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, sans-serif;
    line-height: 1.5;
  }
  .container { max-width: 1220px; margin: 0 auto; }
  header {
    display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap;
    border-bottom: 1px solid var(--border); padding-bottom: 16px; margin-bottom: 24px;
  }
  h1 { margin: 0; font-size: 1.65rem; letter-spacing: 0.02em; }
  h1 span { color: var(--cyan); }
  .meta { color: var(--muted); font-size: 0.88rem; }
  .host-card {
    background: var(--panel); border: 1px solid var(--border);
    border-radius: 12px; padding: 20px; margin-bottom: 24px;
  }
  .host-header {
    display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;
    margin-bottom: 12px;
  }
  .host-ip { font-size: 1.25rem; font-weight: 700; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .badge {
    padding: 4px 10px; border-radius: 999px; font-size: 0.78rem;
    font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
  }
  .badge-crit { background: rgba(244,63,94,0.18); color: #fb7185; border: 1px solid #f43f5e; }
  .badge-high { background: rgba(249,115,22,0.18); color: #fb923c; border: 1px solid #f97316; }
  .badge-warn { background: rgba(245,158,11,0.18); color: #fbbf24; border: 1px solid #f59e0b; }
  .badge-dev  { background: rgba(56,189,248,0.16); color: #38bdf8; border: 1px solid #38bdf8; }
  .badge-info { background: rgba(167,139,250,0.16); color: #c4b5fd; border: 1px solid #a78bfa; }
  .badge-ok   { background: rgba(16,185,129,0.16); color: #34d399; border: 1px solid #10b981; }
  .summary { color: var(--text); margin: 0 0 16px 0; font-size: 0.95rem; }
  .kpis {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 10px; margin-bottom: 18px;
  }
  .kpi {
    background: #0e1420; border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px;
  }
  .kpi-label { color: var(--muted); font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .kpi-val { font-size: 1.25rem; font-weight: 700; margin-top: 2px; font-family: ui-monospace, monospace; }
  .chart-wrap {
    background: #0a0e16; border: 1px solid var(--border); border-radius: 10px;
    padding: 12px; overflow-x: auto; margin-bottom: 16px;
  }
  .chart-title {
    font-size: 0.82rem; color: var(--muted); margin-bottom: 6px;
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;
  }
  .legend span { margin-left: 12px; font-size: 0.78rem; }
  .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 4px; }
  svg text { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  table { width: 100%; border-collapse: collapse; font-size: 0.85rem; margin-top: 8px; }
  th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--border); }
  th { color: var(--muted); font-weight: 600; font-size: 0.76rem; text-transform: uppercase; }
  details { margin-top: 12px; }
  summary { cursor: pointer; color: var(--cyan); font-size: 0.86rem; }
  pre {
    background: #090d14; border: 1px solid var(--border); border-radius: 8px;
    padding: 12px; overflow-x: auto; font-size: 0.78rem; color: #cbd5e1;
  }
  #tooltip {
    position: fixed; pointer-events: none; display: none; z-index: 999;
    background: #0f172a; border: 1px solid var(--cyan); color: var(--text);
    padding: 8px 10px; border-radius: 6px; font-size: 0.78rem;
    font-family: ui-monospace, monospace; box-shadow: 0 8px 24px rgba(0,0,0,0.45);
  }
</style>
</head>
<body>
<div class="container">
  <header>
    <div>
      <h1><span>OodaTap</span> Passive OODA-Loop Report</h1>
      <div class="meta">Source: {{ report.source_path }} &bull; Adapter: {{ report.adapter }} &bull; Total Events: {{ report.total_events }}</div>
    </div>
    <div class="meta">Alerting Hosts: {{ report.alerting_hosts | length }} / {{ report.host_verdicts | length }}</div>
  </header>

  {% for item in host_items %}
  {% set hv = item.verdict %}
  <section class="host-card">
    <div class="host-header">
      <div class="host-ip">{{ hv.host_ip }}</div>
      <span class="badge {{ item.badge_class }}">{{ hv.verdict.value | replace('_', ' ') }}</span>
    </div>
    <p class="summary">{{ hv.summary }}</p>

    <div class="kpis">
      <div class="kpi"><div class="kpi-label">Composite Score</div><div class="kpi-val">{{ "%.2f" | format(hv.scores.composite) }}</div></div>
      <div class="kpi"><div class="kpi-label">Sawtooth (N-S)</div><div class="kpi-val">{{ "%.2f" | format(hv.scores.sawtooth.score) }}</div></div>
      <div class="kpi"><div class="kpi-label">Coupler (N-S↔E-W)</div><div class="kpi-val">{{ "%.2f" | format(hv.scores.coupler.score) }}</div></div>
      <div class="kpi"><div class="kpi-label">Kinematics</div><div class="kpi-val">{{ "%.2f" | format(hv.scores.kinematics.score) }}</div></div>
      <div class="kpi"><div class="kpi-label">Coupled Cycles</div><div class="kpi-val">{{ hv.scores.coupler.coupled_cycle_count }}</div></div>
      <div class="kpi"><div class="kpi-label">Byte-Δ Corr (r)</div><div class="kpi-val">{{ "%.2f" | format(hv.scores.coupler.byte_delta_correlation) }}</div></div>
      <div class="kpi"><div class="kpi-label">Granger F</div><div class="kpi-val">{{ "%.2f" | format(hv.scores.coupler.granger_f_stat) }}</div></div>
      <div class="kpi"><div class="kpi-label">Handoffs</div><div class="kpi-val">{{ hv.scores.kinematics.handoffs | length }}</div></div>
    </div>

    <div class="chart-wrap">
      <div class="chart-title">
        <span>Dual-Track Synchronized OODA Timeline (Relative Seconds)</span>
        <span class="legend">
          <span><i class="dot" style="background:#38bdf8"></i>N-S TLS Uplink (Sawtooth)</span>
          <span><i class="dot" style="background:#f43f5e"></i>Sensitive Lateral Action</span>
          <span><i class="dot" style="background:#10b981"></i>Dev-Local / Benign Action</span>
          <span><i class="dot" style="background:#f59e0b"></i>Compaction Cliff / Handoff</span>
        </span>
      </div>
      <div class="svg-mount" data-host-idx="{{ loop.index0 }}"></div>
    </div>

    {% if hv.scores.kinematics.handoffs %}
    <table>
      <thead>
        <tr><th>Handoff Time (Rel s)</th><th>Transition</th><th>Confidence</th><th>Rationale</th></tr>
      </thead>
      <tbody>
        {% for h in hv.scores.kinematics.handoffs %}
        <tr>
          <td>+{{ "%.1f" | format(h.timestamp - item.t0) }}s</td>
          <td>{{ h.from_regime.value }} &rarr; {{ h.to_regime.value }}</td>
          <td>{{ "%.2f" | format(h.confidence) }}</td>
          <td>{{ h.rationale }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}

    <details>
      <summary>View Elastic Common Schema (ECS) Alert JSON</summary>
      <pre>{{ item.ecs_json }}</pre>
    </details>
  </section>
  {% endfor %}
</div>
<div id="tooltip"></div>
<script>
const HOST_CHARTS = {{ charts_json | safe }};
const tip = document.getElementById("tooltip");

function showTip(evt, html) {
  tip.innerHTML = html;
  tip.style.display = "block";
  tip.style.left = Math.min(window.innerWidth - 260, evt.clientX + 14) + "px";
  tip.style.top = Math.max(10, evt.clientY - 24) + "px";
}
function hideTip() { tip.style.display = "none"; }

function renderChart(mount, data) {
  const W = 1120, H = 290, padL = 62, padR = 24, topH = 135, botY = 175, botH = 82;
  const maxT = Math.max(1, data.duration);
  const maxU = Math.max(1000, data.max_uplink);
  const sx = t => padL + (t / maxT) * (W - padL - padR);
  const syUp = u => 18 + (1 - u / maxU) * (topH - 22);

  const ns = "http://www.w3.org/2000/svg";
  const svg = document.createElementNS(ns, "svg");
  svg.setAttribute("viewBox", `0 0 ${W} ${H}`);
  svg.setAttribute("width", "100%");
  svg.setAttribute("height", H);

  const add = (tag, attrs, parent = svg) => {
    const el = document.createElementNS(ns, tag);
    for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, v);
    parent.appendChild(el);
    return el;
  };

  for (const seg of data.segments) {
    const x1 = sx(seg.start_rel), x2 = sx(seg.end_rel);
    const fill = seg.regime === "autonomous_agent"
      ? "rgba(56,189,248,0.07)"
      : seg.regime === "human_operator"
      ? "rgba(245,158,11,0.09)"
      : "rgba(148,163,184,0.05)";
    add("rect", { x: x1, y: 8, width: Math.max(2, x2 - x1), height: H - 30, fill });
    add("text", { x: x1 + 4, y: H - 8, fill: "#64748b", "font-size": 10 }).textContent = seg.regime;
  }

  add("line", { x1: padL, x2: W - padR, y1: topH + 10, y2: topH + 10, stroke: "#1e293b", "stroke-width": 1 });
  add("text", { x: 6, y: 26, fill: "#94a3b8", "font-size": 10 }).textContent = `${(maxU/1024).toFixed(0)} KB`;
  add("text", { x: 6, y: topH, fill: "#94a3b8", "font-size": 10 }).textContent = "0 KB";
  add("text", { x: 6, y: botY + 14, fill: "#94a3b8", "font-size": 10 }).textContent = "Actions";

  for (const lk of data.links) {
    const x = sx(lk.act_rel);
    add("line", {
      x1: x, x2: x, y1: topH, y2: botY + 8,
      stroke: "rgba(167,139,250,0.45)", "stroke-dasharray": "3,3", "stroke-width": 1.2
    });
  }

  if (data.tls.length > 1) {
    const pts = data.tls.map(p => `${sx(p.t_rel).toFixed(1)},${syUp(p.uplink).toFixed(1)}`).join(" ");
    add("polyline", { points: pts, fill: "none", stroke: "#38bdf8", "stroke-width": 2 });
  }

  for (const p of data.tls) {
    const c = add("circle", {
      cx: sx(p.t_rel), cy: syUp(p.uplink), r: 4,
      fill: p.is_llm ? "#38bdf8" : "#64748b", stroke: "#0b0f17", "stroke-width": 1
    });
    c.style.cursor = "pointer";
    c.addEventListener("mousemove", e => showTip(
      e,
      `<b>N-S TLS Burst (+${p.t_rel.toFixed(1)}s)</b><br/>SNI: ${p.sni}<br/>Uplink: ${p.uplink} B<br/>Downlink: ${p.downlink} B (${p.records} recs)<br/>TTFT: ${p.ttft.toFixed(2)}s`
    ));
    c.addEventListener("mouseleave", hideTip);
  }

  for (const ct of data.cliffs) {
    const x = sx(ct);
    add("line", { x1: x, x2: x, y1: 12, y2: topH + 6, stroke: "#f59e0b", "stroke-dasharray": "4,3", "stroke-width": 1.5 });
  }

  for (const h of data.handoffs) {
    const x = sx(h.t_rel);
    add("line", { x1: x, x2: x, y1: 8, y2: H - 22, stroke: "#f43f5e", "stroke-width": 2 });
    add("text", { x: x + 4, y: 20, fill: "#fb7185", "font-size": 10 }).textContent = `HANDOFF +${h.t_rel.toFixed(0)}s`;
  }

  const maxIn = Math.max(500, ...data.actions.map(a => a.bytes_in));
  for (const a of data.actions) {
    const x = sx(a.t_rel);
    const barH = Math.max(8, (a.bytes_in / maxIn) * (botH - 14));
    const color = a.sensitive ? "#f43f5e" : (a.dir === "dev_local" ? "#10b981" : "#a78bfa");
    const r = add("rect", {
      x: x - 2.5, y: botY + botH - barH, width: 5, height: barH, rx: 1.5, fill: color
    });
    r.style.cursor = "pointer";
    r.addEventListener("mousemove", e => showTip(
      e,
      `<b>Action (+${a.t_rel.toFixed(1)}s)</b><br/>Target: ${a.dst_ip}:${a.dst_port} (${a.proto})<br/>Bytes In: ${a.bytes_in} B<br/>Class: ${a.dir}`
    ));
    r.addEventListener("mouseleave", hideTip);
  }

  mount.appendChild(svg);
}

document.querySelectorAll(".svg-mount").forEach(el => {
  const idx = Number(el.dataset.hostIdx);
  renderChart(el, HOST_CHARTS[idx]);
});
</script>
</body>
</html>
